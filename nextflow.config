manifest {
    name            = 'STTLab/ViroWatch'
    author          = 'STTLab'
    description     = 'HIV-1 ONT genome surveillance pipeline'
    homePage        = 'https://github.com/STTLab/ViroWatch'
    version         = '0.1.0'
    nextflowVersion = '!>=23.10.0'
}

params {
    // Required
    input   = null
    ref_fa  = "${projectDir}/assets/refs/CRF01_AE.fa"
    ref_gff = "${projectDir}/assets/refs/CRF01_AE.gff"
    outdir  = './results'

    // Optional BLAST DBs (both disabled by default)
    blast_db    = null   // LosAlamos HIV DB
    core_nt_db  = null   // NCBI core_nt (requires BLASTDB env var pointing to taxdb)

    // Optional Kraken2 read-set QC (disabled by default)
    kraken2_db         = null   // pre-built Kraken2 DB dir (hash.k2d/opts.k2d/taxo.k2d)
    kraken2_confidence = 0.0    // kraken2 --confidence
    kraken2_z_min      = -1.0   // log-abundance z-score cutoff; taxa below fold into "Other"
    kraken2_min_taxa   = 3      // below this taxa count the z-filter is skipped

    // Optional SnpEff variant annotation (variant calling always runs; annotation
    // is skipped unless a DB key is given)
    snpeff_db     = null   // SnpEff database key (must already be built/available)
    snpeff_config = null   // optional custom snpEff.config; else snpEff's bundled config

    // Optional clinical data for report (CSV with sample_id column)
    vl_csv      = null   // viral load history
    cd4_csv     = null   // CD4 count history

    // Read filtering
    chopper_q      = 10
    chopper_minlen = 2000
    chopper_maxlen = 6000

    // Medaka model
    medaka_model = 'r1041_e82_400bps_sup_v5.2.0'

    // Resource caps
    max_memory = '64.GB'
    max_cpus   = 16
    max_time   = '48.h'
}

conda.enabled = true

workDir = "${projectDir}/work"

includeConfig 'conf/base.config'

profiles {
    test  { includeConfig 'conf/test.config'  }
    mamba {
        conda.enabled       = true
        conda.useMicromamba = true
        docker.enabled      = false
        singularity.enabled = false
    }
}
