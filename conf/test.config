// Test profile — uses bundled assets; no external data required.
// Activate with: nextflow run . -profile test
//
// Site-specific overrides (e.g. outdir, vl_csv) go in conf/site.config,
// not here. See conf/site.config.template.

params {
    input   = "${projectDir}/assets/samplesheet_test.csv"
    ref_fa  = "${projectDir}/assets/refs/CRF01_AE.fa"
    ref_gff = "${projectDir}/assets/refs/CRF01_AE.gff"
    outdir  = './results_test'

    // Bundled example clinical data
    vl_csv  = "${projectDir}/report/example_vl.csv"
    cd4_csv = "${projectDir}/report/example_cd4.csv"

    // Test reads are near-full-length HIV genomes (~7.5–9.3 kb); relax filters
    chopper_maxlen = 10000
    chopper_q      = 8
}
